{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinSlimCenter",
  "version": "0.1.3",
  "identifier": "com.ivanl.winslimcenter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WinSlimCenter",
        "width": 1200,
        "height": 780,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "resources": ["apps.json"],
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
